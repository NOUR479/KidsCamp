<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_back"
                android:backgroundTint="@null"
                android:text="← Retour"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="☀ ÉTÉ"
                android:textColor="#633D30"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bannière -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_kidscamp_hero"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L'AVENTURE EN FAMILLE"
                android:textColor="#FFE2EE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nos petits campeurs 🧒"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chaque enfant a son profil, ses activités et ses aventures."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Formulaire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Votre espace famille 💛"
            android:textColor="#302522"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kidscamp_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvChildFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter un enfant"
                android:textColor="#E61171"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Quelques informations pour commencer."
                android:textColor="#796A64"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_kidscamp_card"
                android:hint="Prénom de l'enfant"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etChildAge"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kidscamp_card"
                android:hint="Âge (en années)"
                android:inputType="number"
                android:padding="12dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSaveChild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#E61171"
                android:text="Ajouter l'enfant"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_back"
                android:backgroundTint="@null"
                android:text="✖ Annuler la modification"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Liste des enfants -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="La petite équipe 🌈"
            android:textColor="#302522"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChildrenCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 enfant"
            android:textColor="#796A64"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/childrenContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNoChildren"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_kidscamp_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="Pas encore de petits campeurs. Ajoutez le premier profil ! ☀"
            android:textColor="#796A64"
            android:visibility="gone" />

        <!-- Pied de page -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="De beaux souvenirs commencent ici ☀"
            android:textColor="#796A64"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
